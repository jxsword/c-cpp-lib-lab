# 构建产物：三套构建方式全部 out-of-source，产物只允许落在 build/<group>/...
/build/
/out/
/reports/**/*.log
CMakeCache.txt
CMakeFiles/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.pdb
*.ilk
*.exp
*.dSYM/

# 本地工具会话状态（非项目文件，不入库）
/.mimosa/
/.zcode/

# 静态分析第①②层原始工具输出：可再生运行时证据，不入库（结论 md/json 与 deps 仍入库）
/reports/**/layer1/
/reports/**/layer2/

# 反例运行日志：运行时证据，不入库（特征串经断言取证）
/tests/reports/
